<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.meto.inventory.controllers.SalesController"
            stylesheets="@styles/style.css">

    <VBox spacing="16" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
        <padding>
            <Insets top="0" right="0" bottom="0" left="0"/>
        </padding>
        
        <!-- Header -->
        <VBox spacing="2">
            <Label text="Sales Section" styleClass="header-title" style="-fx-font-size: 20px;">
                <graphic>
                    <Region styleClass="icon, icon-cart" style="-fx-background-color: -fx-text-main;"/>
                </graphic>
            </Label>
            <Label text="Create new retail transactions with live stock verification" styleClass="header-subtitle" style="-fx-font-size: 11px;"/>
        </VBox>

        <!-- Main Guided 3-Step Content Area -->
        <HBox spacing="14" alignment="TOP_LEFT">
            <!-- STEP 1: Choose Customer & Item Card -->
            <VBox spacing="10" styleClass="sales-step-card" HBox.hgrow="ALWAYS" prefWidth="320">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="STEP 1" styleClass="sales-step-num"/>
                    <Label text="Customer &amp; Item Selection" styleClass="sales-step-title"/>
                </HBox>
                
                <VBox spacing="4">
                    <Label text="Customer Name" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #475569;"/>
                    <ComboBox fx:id="customerNameComboBox" editable="true" promptText="Enter customer name..." maxWidth="Infinity"/>
                </VBox>
                
                <HBox spacing="8">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Item" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="itemsComboBox" promptText="Select item" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="4" prefWidth="120">
                        <Label text="Size / Variant" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="qtyComboBox" promptText="Size" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- STEP 2: Available Stock Level Card -->
            <VBox spacing="8" styleClass="sales-step-card" prefWidth="220" alignment="TOP_CENTER">
                <HBox spacing="6" alignment="CENTER_LEFT" maxWidth="Infinity">
                    <Label text="STEP 2" styleClass="sales-step-num"/>
                    <Label text="Available Stock" styleClass="sales-step-title"/>
                </HBox>

                <VBox fx:id="stockBadgeBox" alignment="CENTER" spacing="3" styleClass="stock-badge-green" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                    <Label text="AVAILABLE IN STOCK" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: #047857;"/>
                    <Label fx:id="availableStockBadge" text="-- Pcs" styleClass="stock-val-green"/>
                    <Label fx:id="stockPackagingLabel" text="Packaging: --" styleClass="stock-pkg-label"/>
                </VBox>
            </VBox>

            <!-- STEP 3: Quantity, Price & Add Card -->
            <VBox spacing="10" styleClass="sales-step-card" HBox.hgrow="ALWAYS" prefWidth="380">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="STEP 3" styleClass="sales-step-num"/>
                    <Label text="Quantity &amp; Pricing" styleClass="sales-step-title"/>
                </HBox>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Quantity / Unit" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #475569;"/>
                        <TextField fx:id="unitField" promptText="e.g., 10 pcs"/>
                        <Label fx:id="unitErrorLabel" text="* Missing units" style="-fx-text-fill: #EF4444; -fx-font-size: 11px;" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Price (UGX)" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #475569;"/>
                        <ComboBox fx:id="priceField" editable="true" promptText="0" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Live Over-Stock Warning Banner -->
                <Label fx:id="stockWarningLabel" text="⚠️ Requested quantity exceeds available stock!" styleClass="stock-warning-banner" visible="false" managed="false" maxWidth="Infinity"/>

                <!-- Quick Unit Selection Buttons -->
                <VBox spacing="4">
                    <FlowPane fx:id="weightButtonsBox" hgap="6" vgap="6">
                        <Button fx:id="quarterKgBtn" text="1/4 kg" styleClass="pill-quick"/>
                        <Button fx:id="halfKgBtn"    text="1/2 kg" styleClass="pill-quick"/>
                        <Button fx:id="kgBtn"        text="Kg"     styleClass="pill-quick"/>
                        <Button fx:id="sackBtn"      text="sack"   styleClass="pill-quick"/>
                    </FlowPane>
                    <FlowPane fx:id="unitButtonsBox" hgap="6" vgap="6">
                        <Button fx:id="pcsBtn"      text="pcs * 1"      styleClass="pill-quick"/>
                        <Button fx:id="halfDozBtn"  text="Half Doz * 6" styleClass="pill-quick"/>
                        <Button fx:id="box10Btn"    text="Box * 10"     styleClass="pill-quick"/>
                        <Button fx:id="box12Btn"    text="Dozen"        styleClass="pill-quick"/>
                        <Button fx:id="box20Btn"    text="Box * 20"     styleClass="pill-quick"/>
                        <Button fx:id="box24Btn"    text="Box * 24"     styleClass="pill-quick"/>
                        <Button fx:id="box72Btn"    text="Box * 72"     styleClass="pill-quick"/>
                        <Button fx:id="crateBtn"    text="Crate * 25"   styleClass="pill-quick"/>
                        <Button fx:id="sackUnitBtn" text="Sack"         styleClass="pill-quick"/>
                    </FlowPane>
                </VBox>

                <Button fx:id="addButton" text="+ Add to Sale List" styleClass="btn-primary" maxWidth="Infinity" style="-fx-font-size: 13px; -fx-padding: 8 16;"/>
            </VBox>
        </HBox>

        <!-- Current Sale Items Container -->
        <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="0" style="-fx-padding: 0;">
            <!-- Sticky Header Bar -->
            <HBox alignment="CENTER_LEFT" styleClass="history-header-bar" spacing="12">
                <Label text="ITEM NAME" prefWidth="200" styleClass="history-header-label"/>
                <Label text="UNIT PRICE" prefWidth="130" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                <Label text="QUANTITY / UNIT" prefWidth="140" alignment="CENTER" styleClass="history-header-label"/>
                <Label text="SIZE" prefWidth="100" alignment="CENTER" styleClass="history-header-label"/>
                <Label text="LINE TOTAL" HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                <Label text="ACTION" prefWidth="80" alignment="CENTER" styleClass="history-header-label"/>
            </HBox>

            <!-- Scrollable Sale Items Container -->
            <ScrollPane fitToWidth="true" styleClass="history-scroll-pane" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="salesListContainer" styleClass="history-list-container" spacing="6">
                        <padding>
                            <Insets top="8" right="12" bottom="12" left="12"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Hidden TableView for backwards compatibility if referenced by internal logic -->
            <TableView fx:id="salesTable" visible="false" managed="false"/>

            <!-- High-Contrast Bottom Checkout Action Bar -->
            <HBox styleClass="checkout-bar" alignment="CENTER_RIGHT" spacing="20">
                <Label fx:id="totalAmountLabel" text="TOTAL: UGX 0" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #10B981;"/>
                
                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" styleClass="debt-toggle-box" spacing="6">
                    <CheckBox fx:id="debtCheckBox" text="Mark as Debt" style="-fx-font-weight: 800; -fx-text-fill: #DC2626; -fx-font-size: 12px;"/>
                </HBox>

                <Button fx:id="saveButton" text="Finalize Sale" styleClass="btn-finalize-sale"/>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>