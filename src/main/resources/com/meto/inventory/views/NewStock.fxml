<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.meto.inventory.controllers.NewStockController"
            prefWidth="900" prefHeight="640"
            stylesheets="@styles/style.css">

    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <content>
                <VBox spacing="30" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="0" right="10" bottom="20" left="0"/>
                    </padding>
                    <children>
                        <!-- Title Section -->
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="New Stock Entry" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                                <Label text="Add new items to your warehouse inventory" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                            </VBox>
                        </HBox>
 
                        <HBox spacing="24" VBox.vgrow="ALWAYS">
                            <!-- Left: Form Card -->
                            <VBox styleClass="card" spacing="24" prefWidth="450" maxWidth="500">
                                <Label text="Stock Details" style="-fx-font-weight: 800; -fx-font-size: 16px;"/>
                                
                                <VBox spacing="16">
                                    <!-- Supplier -->
                                    <VBox spacing="6">
                                        <Label text="Supplier Name" style="-fx-font-weight: 600; -fx-font-size: 12px;"/>
                                        <ComboBox fx:id="supplierNameComboBox" editable="true" maxWidth="Infinity" promptText="e.g. Global Supplies Ltd"/>
                                        <Label fx:id="supplierErrorLabel" text="* Required" visible="false" managed="false" style="-fx-text-fill: -fx-red; -fx-font-size: 11px;"/>
                                    </VBox>
                                    
                                    <!-- Item Selection -->
                                    <HBox spacing="16">
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <Label text="Item Type" style="-fx-font-weight: 600; -fx-font-size: 12px;"/>
                                            <ComboBox fx:id="itemsComboBox" editable="true" maxWidth="Infinity" promptText="Select Item"/>
                                            <Label fx:id="itemErrorLabel" text="* Required" visible="false" managed="false" style="-fx-text-fill: -fx-red; -fx-font-size: 11px;"/>
                                        </VBox>
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <Label text="Item Size" style="-fx-font-weight: 600; -fx-font-size: 12px;"/>
                                            <ComboBox fx:id="qtyComboBox" editable="true" maxWidth="Infinity" promptText="size (e.g. 50kg)"/>
                                             <Label fx:id="qtyErrorLabel" text="* Required" visible="false" managed="false" style="-fx-text-fill: -fx-red; -fx-font-size: 11px;"/>
                                        </VBox>
                                    </HBox>
                                    
                                    <!-- Quick Size Buttons -->
                                    <FlowPane fx:id="qtyButtonsBox" hgap="8" vgap="8" />

                                    <!-- Price -->
                                    <VBox spacing="6">
                                        <Label text="Price (Per Unit)" style="-fx-font-weight: 600; -fx-font-size: 12px;"/>
                                        <TextField fx:id="priceField" promptText="0.00" styleClass="text-field-modern"/>
                                        <Label fx:id="priceErrorLabel" text="* Invalid Price" visible="false" managed="false" style="-fx-text-fill: -fx-red; -fx-font-size: 11px;"/>
                                    </VBox>

                                    <!-- Quantity (Units) -->
                                    <VBox spacing="6">
                                        <Label text="Quantity (Units)" style="-fx-font-weight: 600; -fx-font-size: 12px;"/>
                                        <TextField fx:id="unitField" promptText="e.g., 100 boxes" styleClass="text-field-modern"/>
                                        <Label fx:id="unitErrorLabel" text="* Required" visible="false" managed="false" style="-fx-text-fill: -fx-red; -fx-font-size: 11px;"/>
                                    </VBox>
                                    
                                    <!-- Quick Unit Buttons -->
                                    <FlowPane fx:id="unitButtonsBox" hgap="8" vgap="8" />
                                    
                                    <Region VBox.vgrow="ALWAYS" />
                                    
                                    <HBox spacing="12" alignment="CENTER_RIGHT">
                                        <Button fx:id="clearButton" text="Clear" onAction="#onClear" styleClass="pill" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;"/>
                                        <Button fx:id="addButton" text="+ Add to List" style="-fx-background-color: #111827; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-font-weight: 700;"/>
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- Right: Table Card -->
                            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="16">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <VBox spacing="2">
                                        <Label text="Entry Preview" style="-fx-font-weight: 800; -fx-font-size: 14px;"/>
                                        <Label fx:id="previewSublabel" text="0 items pending" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="saveButton" text="Save Stock" styleClass="btn-green" style="-fx-background-radius: 8; -fx-padding: 8 20;"/>
                                </HBox>
                                
                                <TableView fx:id="newStockTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="previewItemCol" text="Item" prefWidth="200"/>
                                        <TableColumn text="Price" prefWidth="100">
                                            <cellValueFactory><PropertyValueFactory property="price"/></cellValueFactory>
                                        </TableColumn>
                                        <TableColumn fx:id="previewTotalCol" text="Total" prefWidth="100">
                                            <cellValueFactory><PropertyValueFactory property="amount"/></cellValueFactory>
                                        </TableColumn>
                                        <TableColumn text="Unit" prefWidth="80">
                                            <cellValueFactory><PropertyValueFactory property="unit"/></cellValueFactory>
                                        </TableColumn>
                                        <TableColumn fx:id="actionColumn" text="Action" prefWidth="80"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                                
                                <HBox alignment="CENTER_RIGHT" style="-fx-background-color: #F9FAFB; -fx-padding: 16; -fx-background-radius: 8;">
                                    <Label fx:id="totalAmountLabel" text="Total Amount: UGX 0.00" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
