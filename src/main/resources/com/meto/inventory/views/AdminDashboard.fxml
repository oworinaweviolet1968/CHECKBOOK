<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.meto.inventory.controllers.AdminController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label styleClass="header-label" text="Admin Dashboard" />
                  <AnchorPane HBox.hgrow="ALWAYS" />
                  <Button fx:id="refreshButton" mnemonicParsing="false" text="Refresh Users" />
                  <Button fx:id="scanButton" mnemonicParsing="false" text="Scan &amp; Fix All" />
                  <Button fx:id="logoutButton" mnemonicParsing="false" style="-fx-background-color: #ff4444;" text="Logout" />
               </children>
            </HBox>
            
            <!-- Create User Section -->
            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: #f0f0f0; -fx-padding: 10; -fx-background-radius: 5;">
               <children>
                  <Label text="Create New User:" style="-fx-font-weight: bold;" />
                  <javafx.scene.control.TextField fx:id="newUserEmail" promptText="Email" />
                  <javafx.scene.control.PasswordField fx:id="newUserPass" promptText="Password" />
                  <Button fx:id="createUserButton" text="Create Account" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                  <Label fx:id="statusLabel" text="Ready" />
               </children>
            </HBox>
            <TableView fx:id="usersTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="uidColumn" prefWidth="250.0" text="User ID" />
                  <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email (Mock)" />
                  <TableColumn fx:id="ownershipColumn" prefWidth="150.0" text="Ownership Paid" />
                  <TableColumn fx:id="ownershipExpiryColumn" prefWidth="150.0" text="Ownership Expiry" />
                  <TableColumn fx:id="backupColumn" prefWidth="150.0" text="Cloud Backup" />
                  <TableColumn fx:id="backupExpiryColumn" prefWidth="150.0" text="Backup Expiry" />
                  <TableColumn fx:id="lastBackupColumn" prefWidth="180.0" text="Last Backed Up" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
