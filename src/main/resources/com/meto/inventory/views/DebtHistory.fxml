<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.meto.inventory.controllers.DebtHistoryController" styleClass="main-container" stylesheets="@styles/style.css">
    <padding>
        <Insets top="16" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="2">
            <Label text="Debt Management" styleClass="h1" style="-fx-font-size: 20px;"/>
            <Label text="Monitor outstanding balances and settlement history" styleClass="text-muted" style="-fx-font-size: 11px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="notificationsBtn" text="Audit" styleClass="btn-secondary" style="-fx-padding: 4 10; -fx-font-size: 11px;"/>
        <Button fx:id="refreshBtn" text="Refresh Data" styleClass="btn-secondary" style="-fx-padding: 4 10; -fx-font-size: 11px;">
            <graphic>
                <Region styleClass="icon, icon-clock" style="-fx-scale-x: 0.7; -fx-scale-y: 0.7;"/>
            </graphic>
        </Button>
    </HBox>

    <!-- Summary Cards -->
    <HBox spacing="16">
        <VBox spacing="5" styleClass="card, card-debt" HBox.hgrow="ALWAYS" style="-fx-padding: 12;">
            <Label text="Outstanding Debt" styleClass="card-label"/>
            <Label fx:id="totalDebtLabel" text="UGX 0" styleClass="card-value-red" style="-fx-font-size: 20px;"/>
            <Label text="Total balance yet to be collected" styleClass="card-sublabel"/>
        </VBox>

        <VBox spacing="5" styleClass="card" HBox.hgrow="ALWAYS" style="-fx-padding: 12;">
            <Label text="Total Debtors" styleClass="card-label"/>
            <Label fx:id="debtorCountLabel" text="0" styleClass="card-value" style="-fx-font-size: 20px;"/>
            <Label text="Unique customers with active debt" styleClass="card-sublabel"/>
        </VBox>

        <VBox spacing="5" styleClass="card, card-success" HBox.hgrow="ALWAYS" style="-fx-padding: 12;">
            <Label text="Collected Today" styleClass="card-label"/>
            <Label fx:id="collectedTodayLabel" text="UGX 0" styleClass="card-value-green" style="-fx-font-size: 20px;"/>
            <Label text="Debt settlements recorded today" styleClass="card-sublabel"/>
        </VBox>
    </HBox>

    <!-- Main Tabs Section -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="card" style="-fx-padding: 0;">
        <tabs>
            <!-- 1. Active Debts Tab -->
            <Tab text="Active Debts">
                <VBox spacing="0" VBox.vgrow="ALWAYS">
                    <!-- Sticky Header Bar -->
                    <HBox alignment="CENTER_LEFT" styleClass="history-header-bar" spacing="12">
                        <Label text="CUSTOMER" prefWidth="160" styleClass="history-header-label"/>
                        <Label text="ITEM DETAILS" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="history-header-label"/>
                        <Label text="TOTAL" prefWidth="100" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                        <Label text="PAID" prefWidth="100" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                        <Label text="REMAINING BALANCE" prefWidth="130" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                        <Label text="SALE DATE" prefWidth="100" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                        <Label text="ACTIONS" prefWidth="90" alignment="CENTER" styleClass="history-header-label"/>
                    </HBox>

                    <!-- Scrollable Active Debts Card Container -->
                    <ScrollPane fitToWidth="true" styleClass="history-scroll-pane" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="unsettledListContainer" styleClass="history-list-container" spacing="8">
                                <padding>
                                    <Insets top="8" right="12" bottom="12" left="12"/>
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>
            </Tab>

            <!-- 2. Payment History Tab -->
            <Tab text="Payment History">
                <VBox spacing="0" VBox.vgrow="ALWAYS">
                    <!-- Sticky Header Bar -->
                    <HBox alignment="CENTER_LEFT" styleClass="history-header-bar" spacing="12">
                        <Label text="CUSTOMER NAME" prefWidth="220" styleClass="history-header-label"/>
                        <Label text="AMOUNT PAID" prefWidth="180" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                        <Label text="PAYMENT DATE" prefWidth="160" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                        <Label text="STATUS" HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="history-header-label"/>
                    </HBox>

                    <!-- Scrollable Payment Logs Card Container -->
                    <ScrollPane fitToWidth="true" styleClass="history-scroll-pane" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="paymentLogsListContainer" styleClass="history-list-container" spacing="8">
                                <padding>
                                    <Insets top="8" right="12" bottom="12" left="12"/>
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>
            </Tab>

            <!-- 3. Settled Debts Tab -->
            <Tab text="Settled Debts">
                <VBox spacing="0" VBox.vgrow="ALWAYS">
                    <!-- Sticky Header Bar -->
                    <HBox alignment="CENTER_LEFT" styleClass="history-header-bar" spacing="12">
                        <Label text="CUSTOMER" prefWidth="170" styleClass="history-header-label"/>
                        <Label text="ITEM DETAILS" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="history-header-label"/>
                        <Label text="TOTAL AMOUNT" prefWidth="140" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                        <Label text="COMPLETION DATE" prefWidth="120" alignment="CENTER_RIGHT" styleClass="history-header-label"/>
                        <Label text="STATUS" prefWidth="110" alignment="CENTER" styleClass="history-header-label"/>
                    </HBox>

                    <!-- Scrollable Settled Debts Card Container -->
                    <ScrollPane fitToWidth="true" styleClass="history-scroll-pane" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="settledListContainer" styleClass="history-list-container" spacing="8">
                                <padding>
                                    <Insets top="8" right="12" bottom="12" left="12"/>
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
