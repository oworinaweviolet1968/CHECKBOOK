<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import com.meto.inventory.components.LoadingBar?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.meto.inventory.controllers.MainController"
            stylesheets="@styles/style.css">

    <!-- Left navigation -->
    <left>
        <VBox fx:id="leftNav" spacing="8" styleClass="sidebar" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>
            <children>
                <!-- Logo / Header Area -->
                <VBox spacing="4" alignment="CENTER_LEFT">
                    <padding>
                        <Insets bottom="30" left="10" top="10"/>
                    </padding>
                    <Label text="CHECKBOOK IMS" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #111827;"/>
                    <Label text="Inventory Management System" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                </VBox>

                <!-- Navigation Links -->
                <Button fx:id="navInshock" text="In-Stock Inventory" styleClass="nav-button" maxWidth="Infinity">
                     <graphic>
                         <Region styleClass="icon, icon-check"/>
                     </graphic>
                </Button>
                <Button fx:id="navRetail" text="Sales Section" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                         <Region styleClass="icon, icon-cart"/>
                    </graphic>
                </Button>
                <Button fx:id="navHistory" text="History" styleClass="nav-button" maxWidth="Infinity">
                     <graphic>
                         <Region styleClass="icon, icon-clock"/>
                    </graphic>
                </Button>
                <Button fx:id="navMore" text="More" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                         <Region styleClass="icon, icon-more"/>
                    </graphic>
                </Button>
                
                <VBox spacing="5" alignment="CENTER_LEFT">
                    <padding><Insets left="10" top="10"/></padding>
                    <LoadingBar fx:id="syncLoadingBar" visible="false" managed="false" maxWidth="120" />
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Region fx:id="statusDot" styleClass="status-dot, status-dot-checking" minWidth="8" minHeight="8" maxWidth="8" maxHeight="8"/>
                        <Label fx:id="backupStatusLabel" text="Checking..." style="-fx-text-fill: #999; -fx-font-size: 11px;" />
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Bottom Logo -->
                <StackPane alignment="CENTER" maxWidth="Infinity">
                    <padding>
                        <Insets bottom="10"/>
                    </padding>
                    <ImageView fitWidth="100" preserveRatio="true">
                        <Image url="@images/logo.png"/>
                    </ImageView>
                </StackPane>
                
                <!-- Logout Button -->
                <Button fx:id="navLogout" text="Log Out" styleClass="nav-button" maxWidth="Infinity" style="-fx-text-fill: #EF4444;">
                    <graphic>
                         <Region styleClass="icon, icon-logout" style="-fx-background-color: #EF4444;" />
                    </graphic>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- Center content will be swapped by controller -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: -fx-bg-body; -fx-padding: 30;">
            <!-- views will be loaded here -->
        </StackPane>
    </center>

</BorderPane>
