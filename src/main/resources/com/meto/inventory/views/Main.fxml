<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.meto.inventory.controllers.MainController"
            stylesheets="@styles/style.css">

    <!-- Left navigation -->
    <left>
        <VBox fx:id="leftNav" spacing="8" styleClass="sidebar" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>
            <children>
                <!-- Logo / Header Area -->
                <Label text="METO • IMS" styleClass="header-title">
                    <padding>
                        <Insets bottom="30" left="10"/>
                    </padding>
                </Label>

                <!-- Navigation Links -->
                <Button fx:id="navNewStock" text="New Stock" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <Region styleClass="icon, icon-box"/>
                    </graphic>
                </Button>
                <Button fx:id="navRetail" text="Sales Section" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                         <Region styleClass="icon, icon-cart"/>
                    </graphic>
                </Button>
                <Button fx:id="navHistory" text="History" styleClass="nav-button" maxWidth="Infinity">
                     <graphic>
                         <Region styleClass="icon, icon-clock"/>
                    </graphic>
                </Button>
                <Button fx:id="navInshock" text="In-Stock Inventory" styleClass="nav-button" maxWidth="Infinity">
                     <graphic>
                         <Region styleClass="icon, icon-check"/>
                    </graphic>
                </Button>
                
                <Region VBox.vgrow="ALWAYS" />
                
                <!-- Bottom Actions removed per user request -->
            </children>
        </VBox>
    </left>

    <!-- Center content will be swapped by controller -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: -fx-bg-body; -fx-padding: 30;">
            <!-- views will be loaded here -->
        </StackPane>
    </center>

</BorderPane>
